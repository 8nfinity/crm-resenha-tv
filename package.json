    "lint": "next lint",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:check": "tsx scripts/check-db.ts",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "score:recalc": "tsx scripts/recalc-scores.ts",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:criar": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --script"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
