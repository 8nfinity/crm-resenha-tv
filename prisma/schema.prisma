// CRM de WhatsApp — modelo de dados
//
// Regra central deste schema: o funil é histórico, não só estado.
// `Deal.stageId` diz onde o lead está agora; `StageTransition` diz por onde ele passou.
// Sem a segunda tabela, perguntas como "quantos leads chegaram a reunião este mês"
// ficam impossíveis de responder depois — e não dá para reconstruir o passado.

// Prisma 7: a URL do banco não mora mais aqui — está em prisma.config.ts, e o
// PrismaClient recebe um driver adapter (lib/db.ts). O engine em Rust saiu.
generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
  // Sem isto, um `include` de relacao vira uma consulta SEPARADA por relacao.
  // Com o banco a 200ms de distancia, cada relacao custava uma viagem inteira:
  // o funil fazia oito idas para montar uma tela. Com relationJoins da para
  // pedir JOIN de verdade e resolver tudo numa consulta so.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

/// Um número de WhatsApp conectado ao CRM.
///
/// Cada conta é uma instância própria na Evolution API, com sessão e QR Code
/// separados. Desconectar uma não afeta as outras.
model WhatsAppAccount {
  id           String  @id @default(cuid())
  /// Nome da instância na Evolution API. É a chave que liga os dois lados.
  instanceName String  @unique
  /// Apelido que você dá: "Comercial", "Suporte", "Meu pessoal".
  label        String?
  /// Número conectado, preenchido quando a sessão abre.
  phone        String?
  status       String  @default("disconnected")
  /// Cor para distinguir as contas no funil de relance.
  color        String  @default("#25d366")

  lastImportAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  /// Funil onde caem os leads novos deste número. Nulo: o primeiro funil.
  entryPipelineId String?
  entryPipeline   Pipeline? @relation(fields: [entryPipelineId], references: [id], onDelete: SetNull)

  /// SEM USO desde 05/10/2026. Guardavam a "conferência da chave das
  /// etiquetas", que retirava uma etiqueta inexistente de uma conversa — isso
  /// escreve nos dados da conta do WhatsApp e travava a chegada das etiquetas.
  /// Ficam no banco para não exigir migration; nada lê nem grava.
  labelKeyStatus    String?
  labelKeyCheckedAt DateTime?
  labelKeyDetail    String?

  contacts         Contact[]
  labels           WhatsAppLabel[]
  connectionEvents ConnectionEvent[]

  @@index([status])
}

/// Linha do tempo da conexão: quando o WhatsApp abriu ou caiu e o resultado
/// das verificações da chave das etiquetas. É o que mostra se a Evolution
/// reiniciou e voltou sem os arquivos da sessão.
model ConnectionEvent {
  id        String   @id @default(cuid())
  accountId String
  /// "open", "close", "chave_ok", "chave_perdida", "sem_chave", "desconectado", "fora_do_ar", "erro"
  kind      String
  detail    String?
  createdAt DateTime @default(now())

  account WhatsAppAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
}

/// Uma etiqueta do WhatsApp Business, espelhada do aparelho.
///
/// Etiquetas só existem em contas Business — num WhatsApp pessoal esta tabela
/// fica vazia e nada aqui tem efeito.
///
/// `stageId` é o mapeamento: quando você aplica esta etiqueta numa conversa no
/// celular, o lead vai para esse estágio do funil. Nulo significa "etiqueta
/// conhecida, mas sem efeito no funil".
model WhatsAppLabel {
  id        String  @id @default(cuid())
  accountId String
  /// Id da etiqueta no WhatsApp. Estável por conta, não entre contas.
  labelId   String
  name      String
  color     String?
  stageId   String?
  /// Etiqueta de "ignorar": o contato etiquetado some do CRM e as mensagens
  /// dele deixam de entrar. Tirar a etiqueta traz o contato de volta.
  ignoreContact Boolean @default(false)
  /// Etiqueta de ATENDENTE ("João", "Maria"): só registra no histórico do
  /// lead quem atendeu. Não atribui o lead a ninguém.
  isSeller      Boolean @default(false)
  /// Tirada do CRM à mão ("não existe mais no celular"): a Evolution às vezes
  /// continua listando uma etiqueta apagada. Fica escondida até voltar a ser
  /// usada no celular.
  removedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account WhatsAppAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// SetNull, não Cascade: apagar um estágio desfaz o mapeamento, mas não pode
  /// apagar a etiqueta — ela existe no celular independente do CRM.
  stage   Stage?          @relation(fields: [stageId], references: [id], onDelete: SetNull)

  @@unique([accountId, labelId])
  @@index([accountId])
  @@index([stageId])
}

/// Uma pessoa no WhatsApp, dentro de UMA conta.
///
/// O mesmo contato falando com dois números seus vira dois registros, de
/// propósito: o relacionamento é diferente em cada canal, e misturar as duas
/// conversas num lead só produziria um histórico que nunca existiu.
model Contact {
  id            String    @id @default(cuid())
  accountId     String
  waJid         String // "5511999999999@s.whatsapp.net" ou "6219...@lid"
  /// O identificador "@lid" da mesma pessoa. O WhatsApp manda a conversa ora
  /// pelo telefone, ora pelo LID; guardar os dois é o que impede a mesma
  /// pessoa de virar dois leads. Contato só com LID tem lid = waJid.
  lid           String?
  phone         String?
  pushName      String? // nome que a pessoa definiu no WhatsApp
  savedName     String? // nome como está salvo na sua agenda
  profilePicUrl String?
  isGroup       Boolean   @default(false)
  isBusiness    Boolean   @default(false)
  /// Quando foi marcado para ignorar (etiqueta ou à mão). Nulo = visível.
  /// Ignorado não aparece em lugar nenhum e as mensagens dele não entram.
  ignoredAt     DateTime?
  importedAt    DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  account  WhatsAppAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  messages Message[]
  deals    Deal[]
  labelEvents LabelEvent[]

  /// A unicidade é por conta, não global: o mesmo JID pode existir em duas
  /// contas suas sem conflito.
  @@unique([accountId, waJid])
  @@unique([accountId, lid])
  @@index([phone])
  @@index([isGroup])
  @@index([accountId])
}

enum CustomFieldType {
  TEXT
  SELECT
  NUMBER
  DATE
}

/// Um campo que VOCÊ define para os seus leads: origem, segmento, o que for.
///
/// A definição fica aqui e o valor fica em `Deal.customValues`, indexado pelo
/// id do campo. Guardar o valor em JSON em vez de uma tabela de valores evita
/// um join por campo em toda listagem do funil — e num CRM de um usuário só,
/// o custo de não poder indexar esses valores é irrelevante.
model CustomField {
  id      String          @id @default(cuid())
  name    String
  type    CustomFieldType @default(TEXT)
  /// Opções do SELECT, como array de strings. Nulo nos outros tipos.
  options Json?
  order   Int
  /// Mostrar no card do funil, não só no painel do lead.
  showOnCard Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

/// Um funil (Captação, Relacionamento, Processos Seletivos…), como no Pipedrive.
///
/// O lead está em UM funil por vez: o funil é o da coluna onde ele está. Mudar
/// de funil é mudar de coluna — passa por moveDealToStage como qualquer
/// movimento, e o histórico registra a passagem de um funil para o outro.
model Pipeline {
  id        String   @id @default(cuid())
  name      String
  order     Int      @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stages   Stage[]
  /// Números de WhatsApp cujos leads novos caem neste funil.
  accounts WhatsAppAccount[]
}

/// Coluna do kanban. Editável pela interface — nada de estágio hardcoded no código.
model Stage {
  id         String   @id @default(cuid())
  pipelineId String
  name       String
  /// Posição dentro do funil (cada funil numera as suas colunas).
  order      Int
  color      String   @default("#64748b")
  isWon      Boolean  @default(false)
  isLost     Boolean  @default(false)
  createdAt  DateTime @default(now())

  pipeline       Pipeline          @relation(fields: [pipelineId], references: [id])
  deals          Deal[]
  transitionsIn  StageTransition[] @relation("ToStage")
  transitionsOut StageTransition[] @relation("FromStage")
  labels         WhatsAppLabel[]

  @@unique([pipelineId, order])
  @@index([order])
}

/// O card do funil: um contato sendo trabalhado como oportunidade.
model Deal {
  id        String  @id @default(cuid())
  contactId String
  stageId   String
  title     String? // se vazio, a interface cai para o nome do contato
  value     Decimal? @db.Decimal(12, 2)

  /// Score de temperatura (0-100), calculado em lib/scoring.ts.
  score        Int      @default(0)
  /// Fatores que produziram o score, em JSON. Existe para o Claude poder
  /// justificar a recomendação em vez de só citar um número.
  scoreFactors Json?
  scoreUpdatedAt DateTime?

  /// Quando entrou no estágio atual — base do cálculo de "dias parado".
  enteredStageAt    DateTime  @default(now())
  /// Última mensagem em qualquer direção.
  lastInteractionAt DateTime?
  /// Última mensagem recebida DELE. Sinal mais forte que o anterior.
  lastInboundAt     DateTime?

  /// Valores dos campos que você definiu, como { "<id do campo>": valor }.
  /// A definição de cada campo está em CustomField.
  customValues Json?

  /// Negócio e pessoa criados no Pipedrive quando o lead foi enviado para lá.
  /// Guardados para mandar de novo só atualizar, sem duplicar.
  pipedriveDealId   Int?
  pipedrivePersonId Int?
  pipedriveSentAt   DateTime?

  /// A IA de atendimento saiu desta conversa (alguém respondeu pelo celular,
  /// ela passou para um humano, ou foi pausada à mão). Nula: ela atende.
  iaPausadaEm  DateTime?
  iaMotivoPausa String?

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  contact     Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  stage       Stage             @relation(fields: [stageId], references: [id])
  transitions StageTransition[]
  activities  Activity[]
  notes       Note[]

  @@unique([contactId])
  @@index([stageId, score])
  @@index([lastInboundAt])
  @@index([archivedAt])
}

/// Cada movimento de card no kanban vira uma linha aqui. É a fonte de verdade
/// das métricas de conversão e de tempo por estágio.
model StageTransition {
  id          String   @id @default(cuid())
  dealId      String
  fromStageId String?  // nulo quando o deal nasce
  toStageId   String
  at          DateTime @default(now())
  /// Quanto tempo o deal passou no estágio de origem, em horas.
  hoursInFrom Float?

  deal      Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  fromStage Stage? @relation("FromStage", fields: [fromStageId], references: [id])
  toStage   Stage  @relation("ToStage", fields: [toStageId], references: [id])

  @@index([dealId, at])
  @@index([toStageId, at])
  @@index([at])
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  STICKER
  LOCATION
  CONTACT
  OTHER
}

/// Mensagem trocada. Somente leitura no MVP: o envio continua pelo WhatsApp normal.
model Message {
  id          String      @id @default(cuid())
  contactId   String
  waMessageId String
  fromMe      Boolean
  type        MessageType @default(TEXT)
  body        String?     @db.Text
  timestamp   DateTime
  createdAt   DateTime    @default(now())
  /// Enviada pela IA de atendimento (aparece com 🤖 no painel do lead).
  porIA       Boolean     @default(false)

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  /// Idempotência por contato, não global. Com várias contas conectadas, um
  /// mesmo identificador de mensagem pode aparecer em duas delas — sendo
  /// global, a segunda seria descartada como duplicata e a mensagem sumiria.
  @@unique([contactId, waMessageId])
  @@index([contactId, timestamp])
  @@index([timestamp])
  @@index([fromMe])
}

enum ActivityType {
  FOLLOW_UP
  MEETING
  CALL
  PROPOSAL
  OTHER
}

/// O que você fez ou vai fazer com o lead. Base dos relatórios de follow-up
/// e de reuniões que o Claude precisa responder.
model Activity {
  id        String       @id @default(cuid())
  dealId    String
  type      ActivityType
  title     String?
  notes     String?      @db.Text
  dueAt     DateTime?
  doneAt    DateTime?
  /// Quem criou (para saber a quem avisar quando o lead não tem vendedor).
  createdById String?
  /// Quando o lembrete por e-mail saiu. Nulo = ainda não avisado.
  reminderSentAt DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  /// Tipo criado por você ("Avaliação", "Retorno"). Com ele, `type` fica
  /// OTHER: as métricas por tipo continuam iguais e contam isto como "Outro".
  kindId    String?

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  createdBy User? @relation("CriadorDaAtividade", fields: [createdById], references: [id], onDelete: SetNull)
  /// Apagar o tipo não apaga a atividade: ela volta a ser "Outro".
  kind ActivityKind? @relation(fields: [kindId], references: [id], onDelete: SetNull)

  @@index([kindId])
  @@index([dealId, createdAt])
  @@index([type, doneAt])
  @@index([dueAt])
}

/// Tipo de atividade criado por você, além dos fixos (Follow-up, Reunião,
/// Ligação, Proposta, Outro): aparece como mais um botão ao agendar, com a
/// cor dele no calendário.
model ActivityKind {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#94a3b8")
  order     Int      @default(0)
  createdAt DateTime @default(now())

  activities Activity[]
}

/// Anotação livre no card.
model Note {
  id        String   @id @default(cuid())
  dealId    String
  body      String   @db.Text
  createdAt DateTime @default(now())

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId, createdAt])
}

/// Estado geral do sistema. Tabela de uma linha só (`id = "singleton"`).
///
/// O estado de conexão mora em WhatsAppAccount, não aqui: com várias contas
/// conectadas, um status global não significaria nada.
model SystemState {
  id                String    @id @default("singleton")
  lastImportAt      DateTime?
  lastImportSummary Json?
  /// Dia (AAAA-MM-DD, Brasília) do último resumo diário por e-mail.
  lastDigestOn      String?
  /// Chaves das notificações no aparelho (Web Push / VAPID). Geradas pelo
  /// próprio CRM na primeira vez: ninguém precisa configurar nada.
  vapidPublicKey    String?
  vapidPrivateKey   String?

  /// Integração com o Pipedrive. O token nunca volta para o navegador.
  pipedriveToken      String?
  /// Subdomínio da empresa ("resenhatv" em resenhatv.pipedrive.com), lido do
  /// próprio Pipedrive ao salvar o token: é para onde vão as chamadas.
  pipedriveDomain     String?
  /// Funil e etapa do Pipedrive onde os negócios enviados entram.
  pipedrivePipelineId Int?
  pipedriveStageId    Int?
  /// Coluna do CRM que envia o lead sozinho ao entrar nela. Nula: só manual.
  pipedriveAutoStageId String?

  updatedAt         DateTime  @updatedAt
}

/// Uma seção do playbook comercial: roteiros, objeções, preços, processos.
///
/// O conteúdo é Markdown — títulos, listas e negrito sem precisar de editor
/// visual. A ordem é manual: o playbook se lê de cima para baixo, como um
/// treinamento, não por data.
model PlaybookSection {
  id        String   @id @default(cuid())
  title     String
  body      String   @default("") @db.Text
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

enum UserRole {
  MASTER
  ADMIN
  VENDEDOR
}

/// Quem acessa o CRM. Cada vendedor tem o próprio login.
///
/// A senha nunca é guardada: só o hash scrypt (sal aleatório + custo alto).
/// Desativar em vez de apagar mantém o histórico de quem fez o quê.
model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         UserRole  @default(VENDEDOR)
  active       Boolean   @default(true)
  /// Sobe a cada troca de senha ou desativação: invalida as sessões abertas.
  sessionVersion Int     @default(0)
  lastLoginAt  DateTime?
  /// Recebe lembretes e o resumo diário de atividades por e-mail.
  emailNotifications Boolean @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  activities    Activity[]      @relation("CriadorDaAtividade")
  playbookFiles PlaybookFile[]
  pushSubscriptions PushSubscription[]
}

/// Um aparelho (navegador de computador ou celular) que ativou as
/// notificações. Cada pessoa pode ter vários. O endpoint é o endereço do
/// serviço de notificação do navegador (Google, Mozilla, Apple).
model PushSubscription {
  id         String   @id @default(cuid())
  userId     String
  endpoint   String   @unique
  p256dh     String
  auth       String
  /// Que aparelho é ("Chrome no Windows"), para a pessoa reconhecer.
  device     String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Uma etiqueta aplicada ou retirada de uma conversa — o histórico que aparece
/// nas notas do lead. Guarda o NOME da etiqueta na hora: renomear ou apagar a
/// etiqueta depois não reescreve o passado.
model LabelEvent {
  id        String   @id @default(cuid())
  contactId String
  labelId   String
  labelName String
  labelColor String?
  /// "add" ou "remove"
  action    String
  /// O que a etiqueta fez: "estagio", "vendedor", "ignorar" ou "nenhum".
  kind      String
  /// Frase pronta para a tela: "Moveu para Reunião", "Passou para o vendedor Ana".
  detail    String?
  createdAt DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId, createdAt])
}

/// PDF do playbook comercial. O arquivo fica no banco (é pequeno e precisa
/// sobreviver a cada nova publicação do servidor). O texto extraído serve
/// para a busca do playbook achar conteúdo dentro do PDF.
model PlaybookFile {
  id          String   @id @default(cuid())
  name        String
  size        Int
  data        Bytes
  text        String?  @db.Text
  uploadedById String?
  createdAt   DateTime @default(now())

  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

/// Configuração da IA de atendimento (uma linha só, id "singleton").
///
/// Ela qualifica e agenda reuniões pelo WhatsApp, mas só para os leads do
/// funil escolhido — o "funil de teste" enquanto ela é avaliada.
model AgenteIA {
  id           String   @id @default("singleton")
  ativo        Boolean  @default(false)
  /// Funil cujos leads ela atende. Lead em outro funil: ela não responde.
  pipelineId   String?
  /// Como ela se apresenta ("Lia, da Resenha TV").
  nome         String   @default("Lia")
  modelo       String   @default("claude-opus-5-5")
  /// O que a empresa faz, o que vende, para quem — o "playbook" dela.
  empresa      String   @default("") @db.Text
  /// O que perguntar e o que faz um lead estar qualificado.
  qualificacao String   @default("") @db.Text
  /// Dias, horários, duração e como acontece a reunião (link, endereço).
  agenda       String   @default("") @db.Text
  /// Regras extras: tom, o que nunca dizer, quando chamar um humano.
  regras       String   @default("") @db.Text
  /// Para onde ela move o lead ao qualificar e ao agendar (colunas do funil).
  colunaQualificadoId String?
  colunaAgendadoId    String?
  updatedAt    DateTime @updatedAt
}
