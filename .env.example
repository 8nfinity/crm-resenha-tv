# ─── Banco (Supabase) ────────────────────────────────────────────────────────
# No painel do Supabase, botão "Connect" no topo. Existem TRÊS opções ali e a
# escolha errada custa horas de erro sem explicação:
#
#   DATABASE_URL = "Transaction pooler"  (porta 6543)
#     É a que o app usa em runtime. Serverless abre muitas conexões curtas e
#     sem pooler o Postgres estoura o limite. Precisa do ?pgbouncer=true.
#
#   DIRECT_URL = "Session pooler"  (porta 5432, host ...pooler.supabase.com)
#     É a que as migrations usam. O Prisma Migrate não funciona em modo
#     transaction, então não pode ser a de cima.
#
#   NÃO use a "Direct connection" (host db.PROJETO.supabase.co). Ela é
#   IPv6-only no plano gratuito, e a maioria das operadoras brasileiras é
#   IPv4 — o sintoma é um erro de "can't reach database server" que parece
#   senha errada, mas é falta de rota.
#
# Troque [SUA-SENHA] pela senha do banco (Project Settings → Database →
# Reset database password, se você não anotou).
DATABASE_URL="postgresql://postgres.SEUPROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.SEUPROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# ─── Evolution API (a VPS) ───────────────────────────────────────────────────
EVOLUTION_API_URL="https://wa.seudominio.com.br"
EVOLUTION_API_KEY="cole-aqui-a-AUTHENTICATION_API_KEY-do-infra/.env"
EVOLUTION_INSTANCE="crm"

# ─── Webhook: Evolution -> CRM ───────────────────────────────────────────────
# Segredo compartilhado. A Evolution manda no header `apikey` e o CRM confere.
# Gere com: openssl rand -hex 32
WEBHOOK_SECRET="gere-um-valor-aleatorio-longo"

# ─── Endpoint MCP (o conector do claude.ai) ──────────────────────────────────
# Vira parte da URL: https://seu-crm.vercel.app/api/mcp/<MCP_SECRET_PATH>
# Gere com: openssl rand -hex 24
MCP_SECRET_PATH="gere-outro-valor-aleatorio-longo"

# Trava de IP: só a faixa de saída publicada da Anthropic alcança o MCP.
# Deixe vazio APENAS em desenvolvimento local — em produção mantenha o valor.
MCP_ALLOWED_CIDRS="160.79.104.0/21"

# Em dev, o seu IP não está na faixa da Anthropic. Ponha "true" para liberar
# localmente e testar com o MCP Inspector. NUNCA use "true" na Vercel.
MCP_DISABLE_IP_CHECK="false"
