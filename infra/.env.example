# Copie para infra/.env na VPS e preencha.

# Domínio que aponta para o IP desta VPS (registro A no seu DNS).
DOMAIN=wa.seudominio.com.br

# Mesmo valor de DOMAIN, com https://
SERVER_URL=https://wa.seudominio.com.br

# Precisa ser IDÊNTICA à EVOLUTION_API_KEY do .env do CRM.
# Gere com: openssl rand -hex 24
AUTHENTICATION_API_KEY=

# Senha do Postgres interno da Evolution. Gere outra, diferente da de cima.
POSTGRES_PASSWORD=
